+//Called from the cart thread by serial(0x808, ...). Samples past the end of the
+//ring are dropped, as they are on PICO-8.
+void Audio::pushSerialSoundSamples(const uint8_t* samples, int len) {
+    uint32_t write = _serialSoundWrite.load(std::memory_order_relaxed);
+    uint32_t read = _serialSoundRead.load(std::memory_order_acquire);
+
+    for (int i = 0; i < len; i++) {
+        if (write - read >= (uint32_t)SERIAL_SOUND_BUFFER_SIZE) {
+            break;
+        }
+        _serialSoundBuffer[write % SERIAL_SOUND_BUFFER_SIZE] = samples[i];
+        write++;
+    }
+
+    _serialSoundWrite.store(write, std::memory_order_release);
+}
+
+//What stat(108) reports: samples pushed but not yet played.
+int Audio::getSerialSoundBufferLen() {
+    uint32_t write = _serialSoundWrite.load(std::memory_order_acquire);
+    uint32_t read = _serialSoundRead.load(std::memory_order_relaxed);
+
+    return (int)(write - read);
+}
+
+//One buffered sample spans four output samples; an empty ring plays silence
+//without losing the four-sample cadence.
+int16_t Audio::nextSerialSoundSample() {
+    if (_serialSoundPhase == 0) {
+        uint32_t read = _serialSoundRead.load(std::memory_order_relaxed);
+
+        if (_serialSoundWrite.load(std::memory_order_acquire) == read) {
+            _serialSoundValue = 128;
+        }
+        else {
+            _serialSoundValue = _serialSoundBuffer[read % SERIAL_SOUND_BUFFER_SIZE];
+            _serialSoundRead.store(read + 1, std::memory_order_release);
+        }
+    }
+
+    _serialSoundPhase = (_serialSoundPhase + 1) & 3;
+
+    return (int16_t)((_serialSoundValue - 128) * 256);
+}
