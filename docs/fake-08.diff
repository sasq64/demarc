+//PICO-8's `#include` of a `.p8` cart pulls in that cart's code and nothing
+//else: the `pico-8 cartridge ...` banner, the `version` line and any data
+//sections after the code are not Lua and must not reach the compiler. A plain
+//`.lua` file has no section markers at all, so it is taken whole.
+static std::string extractIncludedLua(const std::string& contents) {
+    if (contents.find("__lua__") == std::string::npos) {
+        return contents;
+    }
+
+    std::istringstream s(contents);
+    std::string line;
+    std::string lua;
+    bool inLua = false;
+
+    while (std::getline(s, line)) {
+        auto trimmed = utils::trimright(line, " \n\r");
+        if (trimmed.length() > 2 && trimmed[0] == '_' && trimmed[1] == '_') {
+            inLua = trimmed == "__lua__";
+            continue;
+        }
+        if (inLua) {
+            lua += line + "\n";
+        }
+    }
+
+    return lua;
+}
