+//The optional second argument is a count: PICO-8 returns that many consecutive
+//values, each one word further along, and clamps the count the way peek() does.
+static int peekCount(lua_State *L) {
+    if (lua_gettop(L) < 2) {
+        return 1;
+    }
+    int count = (int)lua_tonumber(L,2);
+    if (count <= 0) {
+        return 1;
+    }
+    return count > 8192 ? 8192 : count;
+}
