+//PICO-8 channel 0x808 is an audio sink: `len` bytes of 8-bit unsigned PCM read
+//from pico memory and queued for playback at 5512.5 Hz. Every other channel is
+//still a no-op here, and each returns the byte count as PICO-8 does.
+int serial(lua_State *L) {
+    int channel = (int)lua_tonumber(L,1);
+    int address = (int)lua_tonumber(L,2);
+    int len = (int)lua_tonumber(L,3);
+
+    if (len < 0) {
+        len = 0;
+    }
+
+    if (channel == 0x808) {
+        //Reading through vm_peek keeps the draw-state memory mapping honoured,
+        //the same way peek() would see it.
+        uint8_t samples[256];
+        for (int i = 0; i < len; i += (int)sizeof(samples)) {
+            int count = len - i;
+            if (count > (int)sizeof(samples)) {
+                count = (int)sizeof(samples);
+            }
+            for (int j = 0; j < count; j++) {
+                samples[j] = _vmForLuaApi->vm_peek(address + i + j);
+            }
+            _audioForLuaApi->pushSerialSoundSamples(samples, count);
+        }
+    }
+
+    lua_pushinteger(L, len);
+
+    return 1;
+}
