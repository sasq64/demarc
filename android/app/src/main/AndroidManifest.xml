<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:glEsVersion="0x00030000" android:required="true" />
    <!-- Releases are downloaded from the links the database lists. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- PlaybackService: the demo keeps playing in the background. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:hasCode="true"
        android:allowBackup="false"
        android:enableOnBackInvokedCallback="false"
        android:theme="@android:style/Theme.NoTitleBar.Fullscreen">

        <!-- No orientation is pinned: configChanges keeps the activity alive
             across a rotation, and the player letterboxes to whatever it gets. -->
        <activity
            android:name=".MiniActivity"
            android:exported="true"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|screenLayout|density|uiMode"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:resizeableActivity="true">

            <!-- The .so name without the "lib" prefix and ".so" suffix. -->
            <meta-data
                android:name="android.app.lib_name"
                android:value="minimarc" />

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- A separate activity: NativeActivity owns its window's surface, so
             a view added over it would never be drawn. -->
        <activity
            android:name=".WebActivity"
            android:exported="false"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|screenLayout|density|uiMode" />

        <service
            android:name=".PlaybackService"
            android:exported="false"
            android:stopWithTask="true"
            android:foregroundServiceType="mediaPlayback" />
    </application>
</manifest>
